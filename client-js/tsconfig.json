{
  "compilerOptions": {
    "rootDir": "../../",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["es6", "dom", "es2019", "es2022"],
    "noImplicitAny": false,
    "module": "Node16",
    "moduleResolution": "node16",
    "skipLibCheck": false,
    "target": "es2015",
    "outDir": "dist",
    "types": ["node"],
    "rewriteRelativeImportExtensions": true,
  },
  "exclude": ["node_modules", "dist"]
}
